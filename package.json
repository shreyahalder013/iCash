{
  "name": "icash-bank",
  "version": "1.0.0",
  "description": "iCash Banking App — Secure cardless face-authenticated banking demo",
  "type": "commonjs",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"server/**/*.js\" \"js/**/*.js\"",
    "db:migrate": "node server/migrate.js",
    "db:seed": "node server/seed.js"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "argon2": "^0.41.1",
    "canvas": "^3.2.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "pg": "^8.13.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@vitest/coverage-v8": "^2.0.5",
    "eslint": "^9.9.1",
    "globals": "^15.9.0",
    "puppeteer-core": "^25.14.0",
    "supertest": "^7.0.0",
    "vitest": "^2.0.5"
  }
}
