datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

enum Role {
  USER
  MERCHANT
  ADMIN
}

enum UserStatus {
  ACTIVE
  LOCKED
  SUSPENDED
}

enum AccountType {
  SAVINGS
  CURRENT
  VIRTUAL
}

enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum TransactionType {
  WITHDRAWAL
  DEPOSIT
  TRANSFER
  PAYMENT
  REFUND
}

enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
  CANCELLED
}

enum BiometricStatus {
  ENROLLED
  PENDING
  REVOKED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum ConversationRole {
  USER
  ASSISTANT
}

enum SplitMethod {
  EQUAL
  PERCENTAGE
  CUSTOM
}

enum SplitPaymentStatus {
  PENDING
  PAID
  CANCELLED
}

model User {
  id                      String     @id @default(uuid())
  full_name               String
  email                   String?    @unique
  email_verified          Boolean    @default(false)
  email_verification_token String?
  email_verification_expires_at DateTime?
  phone                   String     @unique
  aadhaar_reference       String     @unique
  aadhaar_last4           String
  aadhaar_verified        Boolean    @default(true)
  password_hash           String
  emergency_pin_hash      String?
  dob                     DateTime?
  age                     Int?
  is_senior               Boolean    @default(false)
  emergency_contact_name  String?
  emergency_contact_phone String?
  role                    Role       @default(USER)
  status                  UserStatus @default(ACTIVE)
  failed_login_attempts   Int        @default(0)
  locked_until            DateTime?
  created_at              DateTime   @default(now())
  updated_at              DateTime   @updatedAt
  last_login_at           DateTime?

  biometric_profile      BiometricProfile?
  face_template          FaceTemplate?
  accounts               BankAccount[]
  transactions           Transaction[]
  sessions               LoginSession[]
  security_events        SecurityEvent[]
  complaints             Complaint[]
  delegations            DelegatedWithdrawal[]
  merchant_profile       MerchantProfile?
  ai_conversations       AIConversation[]
  notifications          Notification[]
  created_expense_groups ExpenseGroup[]        @relation("GroupCreator")
  group_memberships      GroupMember[]
  split_expenses_paid    SplitExpense[]        @relation("ExpensePayer")
  split_shares           SplitExpenseShare[]
  split_payments_from    SplitPayment[]        @relation("PaymentPayer")
  split_payments_to      SplitPayment[]        @relation("PaymentPayee")
  receipts               Receipt[]
  challenge_progress     ChallengeProgress[]
  reward_badges          RewardBadge[]
  subscriptions          Subscription[]
  better_auth_sessions   Session[]
  better_auth_accounts   Account[]

  @@index([phone])
  @@index([aadhaar_last4])
  @@index([role])
}

model ExpenseGroup {
  id         String         @id @default(uuid())
  name       String
  created_by String
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt
  creator    User           @relation("GroupCreator", fields: [created_by], references: [id], onDelete: Cascade)
  members    GroupMember[]
  expenses   SplitExpense[]

  @@index([created_by])
}

model GroupMember {
  id        String       @id @default(uuid())
  group_id  String
  user_id   String
  joined_at DateTime     @default(now())
  group     ExpenseGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([group_id, user_id])
  @@index([user_id])
}

model SplitExpense {
  id           String              @id @default(uuid())
  group_id     String
  paid_by      String
  description  String
  total_amount Decimal             @db.Decimal(12, 2)
  split_method SplitMethod
  created_at   DateTime            @default(now())
  group        ExpenseGroup        @relation(fields: [group_id], references: [id], onDelete: Cascade)
  payer        User                @relation("ExpensePayer", fields: [paid_by], references: [id], onDelete: Cascade)
  shares       SplitExpenseShare[]
  payments     SplitPayment[]

  @@index([group_id, created_at])
}

model SplitExpenseShare {
  id         String       @id @default(uuid())
  expense_id String
  user_id    String
  amount     Decimal      @db.Decimal(12, 2)
  percentage Decimal?     @db.Decimal(7, 4)
  expense    SplitExpense @relation(fields: [expense_id], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([expense_id, user_id])
  @@index([user_id])
}

model SplitPayment {
  id         String             @id @default(uuid())
  expense_id String
  payer_id   String
  payee_id   String
  amount     Decimal            @db.Decimal(12, 2)
  status     SplitPaymentStatus @default(PENDING)
  paid_at    DateTime?
  created_at DateTime           @default(now())
  expense    SplitExpense       @relation(fields: [expense_id], references: [id], onDelete: Cascade)
  payer      User               @relation("PaymentPayer", fields: [payer_id], references: [id], onDelete: Cascade)
  payee      User               @relation("PaymentPayee", fields: [payee_id], references: [id], onDelete: Cascade)

  @@index([payer_id, status])
  @@index([payee_id, status])
}

model MerchantProfile {
  id              String   @id @default(uuid())
  user_id         String   @unique
  business_name   String
  settlement_acct String
  settled_balance Decimal  @default(0.00) @db.Decimal(12, 2)
  pending_balance Decimal  @default(0.00) @db.Decimal(12, 2)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user             User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  payment_requests PaymentRequest[]
}

model PaymentRequest {
  id             String   @id @default(uuid())
  merchant_id    String
  amount         Decimal  @db.Decimal(12, 2)
  currency       String   @default("INR")
  description    String?
  status         String   @default("PENDING") // PENDING, PAID, EXPIRED
  reference_code String   @unique
  created_at     DateTime @default(now())
  expires_at     DateTime

  merchant MerchantProfile @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
}

model BiometricProfile {
  id                  String          @id @default(uuid())
  user_id             String          @unique
  biometric_provider  String          @default("DEMO_FACIAL_EMBEDDINGS")
  biometric_reference String          @unique
  enrollment_status   BiometricStatus @default(ENROLLED)
  face_descriptors    Json?
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

/// Server-issued liveness challenge for replay-proof biometric authentication.
/// Each challenge is single-use, IP-bound, and expires after 2 minutes.
model BiometricChallenge {
  id             String    @id @default(uuid())
  nonce          String    @unique           // cryptographically random 32-byte hex
  challenge_type String                      // BLINK_ONCE | BLINK_TWICE
  user_id        String?                     // null until face match binds the challenge to a user
  ip_address     String?
  session_ref    String?                     // login session reference if caller is already authenticated
  liveness_session_id String?                 // server-created one-time Flask liveness session bound to this challenge
  expires_at     DateTime
  used_at        DateTime?                   // set when consumed — prevents replay
  created_at     DateTime  @default(now())

  @@index([nonce])
  @@index([user_id])
  @@index([expires_at])
  @@index([liveness_session_id])
}

/// Server-issued liveness nonce for MediaPipe-based client-side liveness (replaces BiometricChallenge)
/// Each nonce is single-use, IP-bound, and expires after 30 seconds.
model LivenessNonce {
  id               String    @id @default(uuid())
  nonce            String    @unique           // cryptographically random 32-byte hex
  required_blinks  Int       @default(2)       // 1 or 2 blinks required
  user_id          String?                     // bound after face match
  ip_address       String?
  expires_at       DateTime
  consumed_at      DateTime?                   // set when consumed — prevents replay
  created_at       DateTime  @default(now())

  @@index([nonce])
  @@index([user_id])
  @@index([expires_at])
}

/// Encrypted face template storage (AES-256-GCM)
/// Replaces plaintext face_descriptors in BiometricProfile
model FaceTemplate {
  id                  String    @id @default(uuid())
  user_id             String    @unique
  encrypted_descriptor Bytes     // AES-256-GCM encrypted Float32Array
  iv                  Bytes       // 12-byte random IV
  auth_tag            Bytes       // 16-byte auth tag
  status              String      @default("ACTIVE") // ACTIVE | REVOKED
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([status])
}

model BankAccount {
  id                    String        @id @default(uuid())
  user_id               String
  bank_name             String
  account_number_masked String
  account_reference     String        @unique
  account_type          AccountType   @default(SAVINGS)
  balance               Decimal       @default(0.00) @db.Decimal(12, 2)
  currency              String        @default("INR")
  is_primary            Boolean       @default(false)
  status                AccountStatus @default(ACTIVE)
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt

  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([user_id])
}

model Transaction {
  id                      String            @id @default(uuid())
  user_id                 String
  account_id              String
  transaction_type        TransactionType
  amount                  Decimal           @db.Decimal(12, 2)
  currency                String            @default("INR")
  description             String
  status                  TransactionStatus @default(COMPLETED)
  reference_number        String            @unique
  idempotency_key         String?           @unique // Client-supplied key to prevent double-spend on retries
  recipient_name          String?
  recipient_account       String?
  created_at              DateTime          @default(now())
  category                String?
  category_confidence     Decimal?          @db.Decimal(5, 4)
  category_user_corrected Boolean           @default(false)

  user           User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account        BankAccount           @relation(fields: [account_id], references: [id], onDelete: Cascade)
  complaints     Complaint[]
  embedding      TransactionEmbedding?
  fraud_analysis FraudAnalysis?

  @@index([user_id])
  @@index([account_id])
  @@index([created_at])
  @@index([idempotency_key])
}

model FraudAnalysis {
  id             String   @id @default(uuid())
  transaction_id String   @unique
  risk_score     Decimal  @db.Decimal(5, 2)
  risk_level     Severity @default(LOW)
  indicators     Json?
  model_version  String   @default("rules-v1")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  transaction Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  @@index([risk_level])
  @@index([created_at])
}

model AIConversation {
  id         String           @id @default(uuid())
  user_id    String
  role       ConversationRole
  message    String
  created_at DateTime         @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
}

model TransactionEmbedding {
  id               String   @id @default(uuid())
  transaction_id   String   @unique
  embedding_vector Json
  category         String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  transaction Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  @@index([category])
}

model LoginSession {
  id                String    @id @default(uuid())
  user_id           String
  session_reference String    @unique
  device_reference  String?
  ip_address        String?
  user_agent        String?
  created_at        DateTime  @default(now())
  expires_at        DateTime
  revoked_at        DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([session_reference])
}

model SecurityEvent {
  id               String   @id @default(uuid())
  user_id          String?
  event_type       String
  severity         Severity @default(LOW)
  description      String
  ip_address       String?
  device_reference String?
  created_at       DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([event_type])
  @@index([severity])
  @@index([created_at])
}

model Complaint {
  id             String          @id @default(uuid())
  user_id        String
  transaction_id String?
  subject        String
  description    String
  status         ComplaintStatus @default(OPEN)
  admin_response String?
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transaction_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([status])
}

model DelegatedWithdrawal {
  id            String   @id @default(uuid())
  user_id       String
  amount        Decimal  @db.Decimal(12, 2)
  otp_hash      String
  status        String   @default("PENDING") // PENDING, USED, EXPIRED, LOCKED
  attempt_count Int      @default(0) // Brute-force protection: locked after 5 failed attempts
  expires_at    DateTime
  created_at    DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([status])
}

// Persistent OTP storage — production-safe alternative to in-memory Map.
// Survives server restarts and works across horizontal scale-out.
model OtpRecord {
  id         String   @id @default(uuid())
  purpose    String // 'register' | 'login'
  mobile     String
  code_hash  String // bcrypt hash of OTP code
  attempts   Int      @default(0)
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  @@unique([purpose, mobile])
  @@index([mobile])
  @@index([expires_at])
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  type       String   @default("INFO")
  title      String
  message    String
  read       Boolean  @default(false)
  metadata   Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, read, created_at])
}

model Receipt {
  id           String    @id @default(uuid())
  user_id      String
  merchant     String?
  receipt_date DateTime?
  total        Decimal?  @db.Decimal(12, 2)
  tax          Decimal?  @db.Decimal(12, 2)
  image_path   String
  confidence   Decimal?  @db.Decimal(5, 4)
  created_at   DateTime  @default(now())

  user  User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items ReceiptItem[]

  @@index([user_id, created_at])
}

model ReceiptItem {
  id         String   @id @default(uuid())
  receipt_id String
  name       String
  quantity   Decimal? @db.Decimal(10, 2)
  amount     Decimal  @db.Decimal(12, 2)

  receipt Receipt @relation(fields: [receipt_id], references: [id], onDelete: Cascade)

  @@index([receipt_id])
}

model SavingChallenge {
  id            String              @id @default(uuid())
  name          String
  description   String?
  target_amount Decimal?            @db.Decimal(12, 2)
  duration_days Int
  active        Boolean             @default(true)
  created_at    DateTime            @default(now())
  progress      ChallengeProgress[]
}

model ChallengeProgress {
  id             String    @id @default(uuid())
  challenge_id   String
  user_id        String
  current_amount Decimal   @default(0) @db.Decimal(12, 2)
  streak         Int       @default(0)
  xp             Int       @default(0)
  completed_at   DateTime?
  joined_at      DateTime  @default(now())

  challenge SavingChallenge @relation(fields: [challenge_id], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([challenge_id, user_id])
  @@index([user_id])
}

model RewardBadge {
  id           String   @id @default(uuid())
  user_id      String
  code         String
  name         String
  description  String?
  awarded_at   DateTime @default(now())
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, code])
  @@index([user_id, awarded_at])
}

model Subscription {
  id              String   @id @default(uuid())
  user_id         String
  merchant        String
  amount          Decimal  @db.Decimal(12, 2)
  interval_days   Int
  next_due_at     DateTime?
  active          Boolean  @default(true)
  reminder_sent   Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, active])
  @@index([merchant])
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}
