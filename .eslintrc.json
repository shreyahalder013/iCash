{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": ["eslint:recommended", "plugin:prettier/recommended"],
  "plugins": ["prettier"],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "rules": {
    "prettier/prettier": ["error", { "endOfLine": "auto" }],
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": "off"
  },
  "overrides": [
    {
      "files": ["**/tests/**/*.js", "**/*.test.js"],
      "env": {
        "jest": true,
        "node": true
      }
    },
    {
      "files": ["frontend/**/*.js"],
      "env": {
        "browser": true
      },
      "globals": {
        "faceapi": "readonly",
        "goTo": "readonly",
        "startCamera": "readonly",
        "stopCamera": "readonly",
        "openModal": "readonly",
        "closeModal": "readonly",
        "currentUser": "writable",
        "executePendingAction": "readonly",
        "pendingVerificationAction": "writable",
        "showAlertToast": "readonly",
        "cameraErrorMessage": "readonly",
        "beginRegisterScan": "readonly",
        "beginLoginScan": "readonly",
        "launchBiometricGate": "readonly",
        "resendOtp": "readonly",
        "proceedToOtp": "readonly",
        "cancelOtp": "readonly",
        "attemptPinDirectLogin": "readonly",
        "toggleSidebar": "readonly",
        "handleCommandInput": "readonly",
        "closeDrawer": "readonly",
        "showTransactionDetails": "readonly",
        "setAmt": "readonly",
        "startLogin": "readonly",
        "startRegistration": "readonly",
        "formatAadhaar": "readonly",
        "handleDobChange": "readonly",
        "launchBiometricGate": "readonly",
        "teardownVerifyGate": "readonly",
        "teardownLoginScan": "readonly",
        "teardownRegisterScan": "readonly",
        "verifyAadhaarLogin": "readonly",
        "toggleBalanceVisibility": "readonly",
        "toggleVerifyPin": "readonly",
        "enterDashboard": "readonly",
        "switchView": "readonly",
        "logout": "readonly",
        "cancelLoginScan": "readonly",
        "cancelRegisterScan": "readonly",
        "cancelVerify": "readonly",
        "openAssistedVoiceMode": "readonly",
        "closeAssistedVoiceMode": "readonly",
        "stopAllCameraLoops": "readonly",
        "toggleAssistMenu": "readonly",
        "closeAssistMenu": "readonly",
        "toggleVoiceGuidance": "readonly",
        "muteVoice": "readonly",
        "unmuteVoice": "readonly",
        "toggleMuteVoice": "readonly",
        "repeatLast": "readonly",
        "stopSpeaking": "readonly",
        "setVoiceSpeed": "readonly",
        "openEmergencyWithdrawalModal": "readonly",
        "initiateTransferWorkflow": "readonly",
        "iCashAccessibility": "readonly",
        "iCashVoice": "readonly",
        "THREE": "readonly"
      },
      "rules": {
        "no-empty": "off"
      }
    }
  ]
}
