# iCash Banking — Environment Configuration
# Copy this file to .env and populate with your values

# ============================================================
# SERVER SETTINGS
# ============================================================
PORT=3000
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-super-secret-session-key-change-in-production

# ============================================================
# DATABASE (choose Option A or Option B)
# ============================================================

# Option A — Individual parameters (recommended for Supabase Pooler)
# PG_HOST=aws-0-ap-south-1.pooler.supabase.com
# PG_PORT=5432
# PG_USER=postgres.your-project-ref
# PG_PASSWORD=your-db-password
# PG_DATABASE=postgres

# Option B — Connection string (Supabase Transaction Pooler or standard)
# SUPABASE_DB_URL=postgresql://postgres.your-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# If neither Option A nor B is set, the server runs in in-memory fallback mode
# (no external database required — perfect for local development)

# ============================================================
# DEMO SEED (development only)
# ============================================================
# Only seeds when ALLOW_DEMO_SEED=true AND NODE_ENV !== 'production'
# ALLOW_DEMO_SEED=true
# DEMO_NORMAL_PIN=2468
# DEMO_EMERGENCY_PIN=9999

# ============================================================
# BIOMETRIC SETTINGS
# ============================================================
# Euclidean distance threshold for face matching (lower = stricter)
# 0.55 = standard; 0.50 = strict; 0.60 = lenient
FACE_MATCH_THRESHOLD=0.55

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=debug